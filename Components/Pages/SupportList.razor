@page "/support-list"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services

@inject CosmosDbService CosmosDbService

<h3>Supporthenvendelser</h3>

<!-- guide -->
<select @bind="selectedCategory" @bind:after="CategoryChanged">
    <option value="Alle">Alle</option>
    <option value="Teknisk spørgsmål">Teknisk spørgsmål</option>
    <option value="Reservedele">Reservedele</option>
    <option value="Forslag">Forslag</option>
    <option value="Forhandler">Forhandler</option>
    <option value="Katalog">Katalog</option>
</select>

<!-- egen -->
<p>Antal henvendelser: @supportMessages?.Count</p>


@if (supportMessages == null)
{
    <p>Henter henvendelser...</p>
}
else if (supportMessages.Count == 0)
{
    <p>Der er ingen henvendelser.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Beskrivelse</th>
            <th>Kategori</th>
            <th>Dato</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var message in supportMessages)
        {
            <tr>
                <td>@message.Name</td>
                <td>@message.Email</td>
                <td>@message.Phone</td>
                <td>@message.Description</td>
                <td>@message.Category</td>
                <td>@message.DateTime</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage>? supportMessages;
    
    // guide
    private string selectedCategory = "Alle";

    protected override async Task OnInitializedAsync()
    {
        supportMessages = await CosmosDbService.GetSupportMessagesAsync();
    }
    
    // guide
    private async Task CategoryChanged()
    {
        if (selectedCategory == "Alle")
        {
            supportMessages = await CosmosDbService.GetSupportMessagesAsync();
        }
        else
        {
            supportMessages = await CosmosDbService.GetSupportMsgByCategoryAsync(selectedCategory);
        }
    }
}